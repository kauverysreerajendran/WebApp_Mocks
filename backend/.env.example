# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/tailortrack

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=10080

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Development only: return the OTP in the API response instead of sending an SMS
OTP_DEV_MODE=true

# Seeded admin account (created by `python -m app.seed`)
ADMIN_EMAIL=admin@tailortrack.local
ADMIN_PASSWORD=change-me-admin

# Platform commission deducted from tailor earnings (percent)
COMMISSION_PERCENT=15

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
